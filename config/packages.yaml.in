packages:
  adios2:
    require: "+hdf5"
  binutils:
    # LLVM depends on binutils with these variants
    require: "+gas+headers+ld"
  boost:
    # Valgrind depends on Boost with these variants
    require: "+atomic+chrono+exception+system+thread"
  cairo:
    require: "+gobject+X"
  cuda:
    require: "@@BOOTSTRAP_CONFIG_CUDA@"
  curl:
    require: "+libidn2"
  doxygen:
    require: "+graphviz"
  elfutils:
    require: "+debuginfod"
  ffmpeg:
    require: "+libaom+libmp3lame+libopenjpeg+libopus+libspeex+libvorbis+libvpx+libwebp+libx264+nonfree"
  fzf:
    require: "+vim"
  gcc:
    # Keep in sync with bootstrap script
    prefer: ["@16"]
  gl:
    require: "osmesa"
  gnuplot:
    require: "+X"
  graphviz:
    require: "+libgd+pangocairo+poppler"
  harfbuzz:
    require: "+gobject"
  hdf5:
    require: "+hl+szip+threadsafe"
  libfabric:
    require: "fabrics=sockets,tcp,udp,verbs,rxd,rxm"
  libfuse:
    # FIXME Check whether this needs to be the same version as the system FUSE
    require: "~utils"
  mpi:
    require: "mpich"
  octave:
    # FIXME +gl2ps+opengl+qscintilla+qt
    require: "+arpack+fftw+fontconfig+freetype+gnuplot+hdf5+llvm+qrupdate+suitesparse"
  pango:
    require: "+X"
  pcre:
    require: "+jit"
  postgresql:
    require: "+client_only+threadsafe"
  py-matplotlib:
    require: "backend=qt5agg"
  py-scikit-build-core:
    require: "+pyproject"
  py-setuptools:
    prefer: ["@80"]
  qt:
    require: "+opengl"
  qt-base:
    require: "+opengl"
  rdma-core:
    require: "~pyverbs"
  vim:
    require: "features=huge +python"
  zstd:
    require: "+programs"
  # CUDA
  magma:
    # Keep in sync with py-torch
    require: "cuda_arch=80,86,90,90a"
  nccl:
    # Keep in sync with py-torch
    require: "cuda_arch=80,86,90,90a"
  py-networkx:
    # Avoid pulling in LLVM and Qt (via py-matplotlib and py-pandas)
    require: "~default"
  py-torch:
    require: "cuda_arch=80,86,90,90a ~mpi ~valgrind"
  all:
    # Make sure to build for a generic architecture
    target: [x86_64_v3]
